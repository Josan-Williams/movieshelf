# Copy this file to .env and replace the placeholder passwords.
# .env is git-ignored; this example file is committed and must never contain real secrets.

# --- Better Auth ---
BETTER_AUTH_SECRET=<output of the node crypto command>
BETTER_AUTH_URL=some-kinda-url

# --- Development database (docker compose service: db) ---
POSTGRES_USER=movieshelf
POSTGRES_PASSWORD=devpassword123
POSTGRES_DB=movieshelf
POSTGRES_PORT=5432
DATABASE_URL=postgresql://movieshelf:devpassword123@localhost:5432/movieshelf

# --- Test database (docker compose service: db_test) ---
TEST_POSTGRES_USER=movieshelf_test
TEST_POSTGRES_PASSWORD=testpassword123
TEST_POSTGRES_DB=movieshelf_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://movieshelf_test:testpassword123@localhost:5433/movieshelf_test
