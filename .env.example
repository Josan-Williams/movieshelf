# .env is git-ignored; this example file is committed and must never contain real secrets.

# --- Development database (docker compose service: db) ---
POSTGRES_USER=movieshelf
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=movieshelf
POSTGRES_PORT=5432
DATABASE_URL=postgresql://movieshelf:change-me-dev@localhost:5432/movieshelf

# --- Test database (docker compose service: db_test) ---
TEST_POSTGRES_USER=movieshelf_test
TEST_POSTGRES_PASSWORD=change-me-test
TEST_POSTGRES_DB=movieshelf_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://movieshelf_test:change-me-test@localhost:5433/movieshelf_test

# --- Authentication (Better Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# --- TMDB (required for search): https://www.themoviedb.org/settings/api -> "API Read Access Token" ---
TMDB_API_READ_TOKEN=SUMN_YOU'LL_NEVER_KNOW

# --- AI natural-language search (optional: without a key the app uses the non-AI fallback parser) ---
# Any OpenAI-compatible chat completions API. Default: Google Gemini (key from https://aistudio.google.com/apikey)
AI_API_KEY=SUMN_YOU'LL_NEVER_KNOW
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
